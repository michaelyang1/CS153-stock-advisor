# Preferred: OpenRouter API key (course inference credits). When set, the
# Atlas chat runs through OpenRouter — anthropic/claude-sonnet-4.6 by default.
OPENROUTER_CS153_API_KEY=sk-or-v1-...

# Fallback: direct Anthropic API key (used only when no OpenRouter key is set)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model id for whichever provider is active
#   OpenRouter slug, e.g. anthropic/claude-sonnet-4.6, openai/gpt-5.1
#   Anthropic id,    e.g. claude-sonnet-4-5
# ADVISOR_MODEL=
